    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Is this process able to serve? For the container's health check.\n\nMinimal on purpose: it fails if the process no longer answers or if\npokedex.db cannot be read. The appearance model and feedback.db are left\nout: without them most of the site still works, and restarting the\ncontainer in a loop would turn a partial problem into a full outage.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
