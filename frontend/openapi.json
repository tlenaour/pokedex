  "paths": {
    "/pokemon": {
      "get": {
        "tags": [
          "pokemon"
        ],
        "summary": "Search Pokemon",
        "description": "All the Pokémon in Pokédex order (the catalog), optionally filtered.",
        "operationId": "search_pokemon_pokemon_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Part of the name",
              "title": "Q"
            },
            "description": "Part of the name"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/PokemonType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          },
          {
            "name": "habitat",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Habitat"
            }
          },
          {
            "name": "legendary",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Legendary"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PokemonSummary"
                  },
                  "title": "Response Search Pokemon Pokemon Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pokemon/suggest": {
      "get": {
        "tags": [
          "pokemon"
        ],
        "summary": "Suggest Pokemon",
        "description": "Find a Pokémon from a partially remembered name, best matches first.",
        "operationId": "suggest_pokemon_pokemon_suggest_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Beginning (or part) of the name, e.g. `bulba`",
              "title": "Q"
            },
            "description": "Beginning (or part) of the name, e.g. `bulba`"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 5,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PokemonSuggestionOut"
                  },
                  "title": "Response Suggest Pokemon Pokemon Suggest Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pokemon/identify": {
      "get": {
        "tags": [
          "pokemon"
        ],
        "summary": "Identify",
        "description": "Identify a Pokémon from a description of its appearance, closest first.",
        "operationId": "identify_pokemon_identify_get",
        "parameters": [
          {
            "name": "description",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "What the Pokémon looks like, e.g. `small yellow mouse with red cheeks`",
              "title": "Description"
            },
            "description": "What the Pokémon looks like, e.g. `small yellow mouse with red cheeks`"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 5,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PokemonIdentificationOut"
                  },
                  "title": "Response Identify Pokemon Identify Get"
                }
              }
            }
          },
          "503": {
            "description": "Search by appearance unavailable: index missing or stale, or model not loadable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
